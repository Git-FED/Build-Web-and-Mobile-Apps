{
  "name": "web2apk",
  "version": "1.0.0",
  "description": "Turn any live website URL into launch-ready Android, iOS, desktop and PWA app configurations.",
  "main": "electron/main.cjs",
  "scripts": {
    "sync": "npx cap sync android",
    "build:apk": "npx cap sync android && node scripts/run-gradle.mjs assembleDebug",
    "test": "node scripts/test.mjs",
    "dist": "electron-builder",
    "build:pages": "sh cloudflare-pages-build.sh",
    "build": "npm run build:pages",
    "verify": "npm test && npm run build:pages",
    "deploy:pages": "npm run verify && test -n \"$CF_PAGES_PROJECT\" && wrangler pages deploy dist --project-name \"$CF_PAGES_PROJECT\" --config wrangler.pages.toml",
    "deploy": "npm run verify && wrangler deploy",
    "deploy:worker": "npm run deploy"
  },
  "keywords": [
    "capacitor",
    "android",
    "apk",
    "webview",
    "ios",
    "electron",
    "pwa",
    "app-builder"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "wrangler": "4.144.0"
  },
  "build": {
    "extends": "./electron-builder.yml",
    "linux": {
      "maintainer": "FED Shell <support@example.com>",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "homepage": "https://github.com/FED-OS/Build-Mobile-Apps-Android-iOS",
  "desktopName": "my-web-app",
  "engines": {
    "node": ">=22.23.0 <23",
    "npm": ">=10 <12"
  }
}
